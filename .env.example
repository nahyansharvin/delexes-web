# Copy to .env.local and fill in real values. Never commit real values.

# WhatsApp number, international format, digits only (no +, spaces, dashes)
VITE_WHATSAPP_NUMBER=233000000000

# Google Apps Script web app deployment URL (see docs/contact-form-setup.md)
VITE_GOOGLE_SHEETS_URL=https://script.google.com/macros/s/REPLACE_ME/exec
